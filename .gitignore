backend/evidence/*
!backend/evidence/.gitkeep
*.raw
*.dmp
*.vmem
*.crash
*.img
*.iso
*.docx

# ============================================================
# Reports & Analysis Generated Files
# ============================================================
reports/*
!reports/.gitkeep

